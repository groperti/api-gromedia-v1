PORT=4881
CDN_API_KEY=your-global-api-key-here
MEDIA_PUBLIC_API_KEY=sk
# Contabo Object Storage (S3-compatible, Singapore)
S3_ACCESS_KEY=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_BUCKET_REGION=
S3_ENDPOINT=

CDN_BASE_URL=

# MongoDB
MONGO_URI=


# JWT — same secret as api-groperti-v2
JWT_SECRET=

# Image processing tuning
AVIF_QUALITY=52
AVIF_EFFORT=3
WM_RATIO=0.24
WM_OPACITY=0.55
IMAGE_MAX_WIDTH=1600

# Layer 2 admission control. Caps simultaneous encodes so saturation triggers a
# fast 503 + Retry-After instead of stalling until the proxy times out.
#   MEDIA_MAX_INFLIGHT — concurrent encode pipelines (≈ UV_THREADPOOL_SIZE)
#   MEDIA_MAX_QUEUED   — additional callers held briefly before 503 is returned
#   MEDIA_RETRY_AFTER_SEC — value advertised in the Retry-After header
MEDIA_MAX_INFLIGHT=16
MEDIA_MAX_QUEUED=32
MEDIA_RETRY_AFTER_SEC=5
